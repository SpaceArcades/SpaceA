{
  "site": {
    "name": "SpaceArcades",
    "version": "2.0",
    "theme": "dark"
  },
  "storage": {
    "format": "json",
    "activeGamesCollection": "games.activeGames",
    "deletedGamesCollection": "games.deletedGames",
    "thumbnailDirectory": "thumbnails/",
    "sharedAcrossVisitors": true,
    "requiresServerApiForWrites": true
  },
  "features": {
    "addGames": true,
    "deleteGames": true,
    "restoreGames": true,
    "permanentlyDeleteGames": true,
    "uploadThumbnails": true,
    "confirmBeforeDelete": true,
    "preserveThumbnailInRecycleBin": true
  },
  "roles": {
    "admin": {
      "color": "purple",
      "permissions": ["add-games"]
    },
    "coOwner": {
      "color": "orange",
      "permissions": ["add-games", "remove-games", "restore-games"]
    },
    "owner": {
      "color": "gold",
      "permissions": [
        "add-games",
        "remove-games",
        "restore-games",
        "permanently-delete-games",
        "manage-roles"
      ]
    }
  },
